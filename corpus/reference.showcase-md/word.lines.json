      {"page": 2, "text": "Overview", "x": 62.4, "top": 83.9, "width": 71.55, "height": 21.98, "baseline": 101.04},
      {"page": 2, "text": "The first paragraph after a heading takes the First Paragraph style. Later paragraphs take Body Text.", "x": 62.4, "top": 112.96, "width": 468.79, "height": 12, "baseline": 122.64},

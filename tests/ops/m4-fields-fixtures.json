{
  "schema_version": 1,
  "id": "m4.fields.minimal",
  "upstream": [
    "tests/paper/test_fields_bookmarks.py::DescribeFieldAuthoring (date field placeholder, TOC complex field, historical TOC destinations, TOC levels)"
  ],
  "fixture": "generated/minimal-clean/minimal.docx",
  "cases": [
    {"name": "date-format", "steps": [
      {"op": "fields.add_date_field", "args": [{"$paragraph": "Second body paragraph"}], "kwargs": {"date_format": "MMMM d, yyyy"}}],
     "expect": {"steps": [{"outcome": "ok"}], "changed_parts": ["word/document.xml", "word/settings.xml"]}},
    {"name": "toc-complex-field", "steps": [
      {"op": "fields.insert_toc_after", "args": ["Minimal Clean Document"], "kwargs": {"levels": [1, 3]}}],
     "expect": {"steps": [{"outcome": "ok"}], "changed_parts": ["word/document.xml", "word/settings.xml"], "reopen_contains": ["Table of contents placeholder"]}},
    {"name": "toc-historical-block", "steps": [
      {"op": "fields.insert_toc_after", "args": [{"$block": "Minimal Clean Document", "view": "original"}]}],
     "expect": {"steps": [{"outcome": "error", "category": "unsupported_structure"}], "changed_parts": []}},
    {"name": "toc-historical-span", "steps": [
      {"op": "fields.insert_toc_after", "args": [{"$span": "Minimal Clean Document", "view": "all"}]}],
     "expect": {"steps": [{"outcome": "error", "category": "unsupported_structure"}]}},
    {"name": "toc-levels-reversed", "steps": [
      {"op": "fields.insert_toc_after", "args": ["Minimal Clean Document"], "kwargs": {"levels": [3, 1]}}],
     "expect": {"steps": [{"outcome": "error", "category": "invalid_argument"}]}},
    {"name": "reference-unknown", "steps": [
      {"op": "fields.add_reference_field", "args": [{"$paragraph": "Second body paragraph"}], "kwargs": {"bookmark": "Ghost"}}],
     "expect": {"steps": [{"outcome": "error", "category": "target_not_found"}]}},
    {"name": "caption", "steps": [
      {"op": "fields.add_caption", "args": [{"$paragraph": "Second body paragraph"}], "kwargs": {"label": "Figure", "description": "Overview"}}]}
  ]
}
